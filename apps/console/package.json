{
  "name": "@brickellstatus/console",
  "private": true,
  "version": "0.1.44",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "node ./scripts/tauri.mjs",
    "tauri:dev": "node ./scripts/tauri.mjs dev",
    "tauri:build": "node ./scripts/tauri.mjs build",
    "tauri:build:mac": "node ./scripts/build-macos-dmg.mjs",
    "tauri:build:win": "node ./scripts/build-windows-installer.mjs",
    "tauri:ios:init": "node ./scripts/tauri.mjs ios init",
    "tauri:ios:dev": "node ./scripts/tauri.mjs ios dev",
    "tauri:ios:build": "node ./scripts/tauri.mjs ios build",
    "ios:prepare": "npm run licenses:bundle && npm run build",
    "tauri:android:init": "node ./scripts/tauri.mjs android init",
    "tauri:android:dev": "node ./scripts/tauri.mjs android dev",
    "tauri:android:build": "node ./scripts/tauri.mjs android build --apk --split-per-abi --target aarch64 armv7",
    "tauri:android:bundle": "node ./scripts/tauri.mjs android build --aab --target aarch64 armv7",
    "tauri:build:linux": "node ./scripts/build-linux-rpm.mjs",
    "assets:mac": "node ./scripts/generate-macos-assets.mjs",
    "licenses:bundle": "node ./scripts/generate-license-bundle.mjs",
    "firmware:bundle": "python3 ../../firmware/panel/scripts/bundle_firmware.py --skip-build",
    "desktop:prepare": "npm run licenses:bundle && npm run firmware:bundle && npm run build",
    "android:prepare": "node ./scripts/sync-droidplug-java.mjs --check && npm run licenses:bundle && npm run build",
    "size:mac": "node ./scripts/check-macos-artifact-size.mjs",
    "size:win": "node ./scripts/check-windows-artifact-size.mjs",
    "size:android": "node ./scripts/check-android-artifact-size.mjs",
    "size:linux": "node ./scripts/check-linux-artifact-size.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "allowScripts": {
    "fsevents": false
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@lucide/svelte": "^1.33.0",
    "@tauri-apps/api": "^2.11.1",
    "maplibre-gl": "^6.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
