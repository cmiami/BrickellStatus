{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrickellStatus",
  "version": "../../console/package.json",
  "identifier": "com.cmiami.brickellstatus",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../console"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run desktop:prepare",
      "cwd": "../../console"
    },
    "frontendDist": "../../console/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BrickellStatus",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#DDE3E8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://tiles.openfreemap.org https://tilecache.rainviewer.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://tiles.openfreemap.org https://geocoding-api.open-meteo.com https://tilecache.rainviewer.com https://api.rainviewer.com; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/licenses/": "licenses/",
      "resources/firmware/": "firmware/"
    },
    "licenseFile": "../../../LICENSE-MIT",
    "copyright": "Copyright \u00a9 2026 BrickellStatus contributors",
    "category": "Utility",
    "shortDescription": "A configurable personal signal console.",
    "longDescription": "BrickellStatus monitors user-selected signals, predicts Brickell Avenue Bridge openings, and routes trusted updates to desktop, WhatsApp, and a Heltec E213 or E290 e-paper display.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "BrickellStatus"
      }
    },
    "linux": {
      "rpm": {
        "release": "1",
        "compression": {
          "type": "zstd",
          "level": 19
        },
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "dbus-libs",
          "systemd-libs"
        ],
        "recommends": [
          "bluez"
        ],
        "desktopTemplate": "linux/brickellstatus.desktop",
        "postInstallScript": "linux/post-install.sh",
        "postRemoveScript": "linux/post-remove.sh",
        "files": {
          "/usr/lib/udev/rules.d/70-brickellstatus-espressif.rules": "linux/70-brickellstatus-espressif.rules"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    }
  }
}
