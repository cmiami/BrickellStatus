<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device by backup or by transfer to a
  new phone. The local credential file holds a WhatsApp token and an AISStream
  key in plaintext on Android, and the SQLite database holds observed vessel
  positions; neither is worth carrying into a cloud backup a user did not
  think about. android:allowBackup="false" covers Android 11 and earlier, and
  this file covers 12 and later, which ignores that attribute for these paths.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
